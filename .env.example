# Copy to .env and fill in. This file is bundled into the app: public values only, never secrets.

# Backend URL including /api/v1
API_BASE_URL=http://localhost:8000/api/v1
# Android emulator reaches the computer's localhost through 10.0.2.2 (optional; wins on Android when set)
API_BASE_URL_ANDROID=http://10.0.2.2:8000/api/v1

# Optional, in seconds (defaults 10 and 20)
CONNECT_TIMEOUT_SECONDS=10
RECEIVE_TIMEOUT_SECONDS=20
